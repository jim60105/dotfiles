[user]
{{- if and .gitSigningKey (not .codespaces) }}
	signingkey = {{ .gitSigningKey }}
{{- end }}
	name = {{ .name }}
	email = {{ .email }}
[commit]
{{- if env "WSL_DISTRO_NAME" }}
	# No GPG keyring/pinentry in WSL until keys are imported; sign commits from the host.
	gpgsign = false
{{- else }}
	gpgsign = true
{{- end }}
[core]
	autocrlf = input
{{- if .devcontainer }}
	editor = code-insiders --wait
{{- else }}
	editor = vim
{{- end }}
	safecrlf = warn
[tag]
{{- if env "WSL_DISTRO_NAME" }}
	gpgsign = false
{{- end }}
	forceSignAnnotated = true
{{- if eq .chezmoi.hostname "Jim-Fedora" }}
[safe]
	directory = /var/mnt/ssd/AI/docker-stable-diffusion-webui
	directory = /var/mnt/ssd/AI/docker-stable-diffusion-webui/stable-diffusion-webui
	directory = /var/mnt/ssd/AI/kohya_ss
	directory = /var/mnt/ssd/AI/kohya_ss/sd-scripts
	directory = /var/mnt/ssd/AI/docker-stable-diffusion-webui/data/extensions/civitai-shortcut-fork
{{- else if eq .chezmoi.hostname "CHT-4000-Ada" }}
[safe]
	directory = /var/mnt/CHT-Kingston/*
{{- end }}
[init]
	defaultBranch = master
{{- if not .devcontainer }}
[gpg]
	program = /usr/bin/gpg
[credential]
	helper = store
	credentialStore = gpg
{{- end }}
[credential "https://codeberg.org"]
	provider = generic
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[protocol "file"]
	allow = always
